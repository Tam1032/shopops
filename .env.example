# Any OpenAI-compatible endpoint. Leave LLM_MODEL empty to use the keyword baseline.
# OpenAI:            LLM_MODEL=gpt-4.1-mini
# Self-hosted vLLM:  LLM_BASE_URL=http://localhost:8001/v1  LLM_MODEL=Qwen/Qwen3-8B
# Ollama:            LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen3:8b
# Anthropic:         LLM_BASE_URL=https://api.anthropic.com/v1/  LLM_MODEL=<claude model id>
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=

# LLM-as-judge for evals (optional)
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
