{
  "name": "ShopOps – run approved actions",
  "nodes": [
    {
      "id": "8829e42b-e3c7-5990-bff1-a1192e9ac2f4",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "2536e934-ddd3-5c5f-b86b-d7cb399e160c",
      "name": "Read approval sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        220,
        0
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "queue"
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "323fb9b9-b726-5d1e-957f-7af871f4e6a8",
      "name": "Approved and pending",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $json.approved }}",
              "rightValue": "yes",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "f2",
              "leftValue": "={{ $json.status }}",
              "rightValue": "pending",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ee767991-4b09-5190-91c5-6eb3b699a37f",
      "name": "Run action",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://agent:8200/actions/{{ $json.action_id }}/approve",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.proposed === 'post_reply' ? { arguments: { text: $json.draft } } : {}) }}",
        "options": {}
      }
    },
    {
      "id": "b14eaf1f-130f-581f-9e9b-7dfa411a0daf",
      "name": "Mark done in sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        880,
        0
      ],
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "queue"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "action_id": "={{ $('Approved and pending').item.json.action_id }}",
            "status": "done"
          },
          "matchingColumns": [
            "action_id"
          ],
          "schema": [
            {
              "id": "action_id",
              "displayName": "action_id",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Read approval sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read approval sheet": {
      "main": [
        [
          {
            "node": "Approved and pending",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Approved and pending": {
      "main": [
        [
          {
            "node": "Run action",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run action": {
      "main": [
        [
          {
            "node": "Mark done in sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {}
}