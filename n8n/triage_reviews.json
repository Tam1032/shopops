{
  "name": "ShopOps – triage new reviews",
  "nodes": [
    {
      "id": "45262921-233d-50f1-9aa7-92bd57b79518",
      "name": "Every 15 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      }
    },
    {
      "id": "fe5c987c-ec5b-556f-87c9-eebe1bff1e8b",
      "name": "List new reviews",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "http://marketplace:8000/reviews",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "new"
            },
            {
              "name": "limit",
              "value": "20"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "7bf3c13b-ba83-5cbb-a755-38094482ff75",
      "name": "One item per review",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      }
    },
    {
      "id": "b2870138-a18b-5a34-9f50-197bdaa40067",
      "name": "New review webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        220
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "shopops-review",
        "options": {}
      },
      "webhookId": "6cf72550-c537-54c5-97f1-b3b5ecb343f5"
    },
    {
      "id": "38a3c19d-2d66-5869-b02f-5f6b328952f0",
      "name": "Review from webhook",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        220
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "review_id",
              "value": "={{ $json.body.review.review_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "0b746f34-40b2-5d3d-8d4e-3fca9fe4a6c9",
      "name": "Triage with agent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://agent:8200/triage/{{ $json.review_id }}",
        "options": {
          "timeout": 120000
        }
      }
    },
    {
      "id": "1e50eaf5-063b-50d5-8b19-a6e9973b66d8",
      "name": "Row for approval sheet",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        100
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "r1",
              "name": "action_id",
              "value": "={{ $json.next_action?.id }}",
              "type": "number"
            },
            {
              "id": "r2",
              "name": "review_id",
              "value": "={{ $json.review_id }}",
              "type": "string"
            },
            {
              "id": "r3",
              "name": "review",
              "value": "={{ $json.review_text }}",
              "type": "string"
            },
            {
              "id": "r4",
              "name": "sentiment",
              "value": "={{ $json.labels?.sentiment }}",
              "type": "string"
            },
            {
              "id": "r5",
              "name": "topic",
              "value": "={{ $json.labels?.topic }}",
              "type": "string"
            },
            {
              "id": "r6",
              "name": "proposed",
              "value": "={{ $json.next_action?.tool }}",
              "type": "string"
            },
            {
              "id": "r7",
              "name": "draft",
              "value": "={{ $json.next_action?.text }}",
              "type": "string"
            },
            {
              "id": "r8",
              "name": "approved",
              "value": "",
              "type": "string"
            },
            {
              "id": "r9",
              "name": "status",
              "value": "pending",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "ba6a9ef4-18eb-583b-9f05-2a2307317c27",
      "name": "Append to approval sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "url",
          "value": "https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/edit"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "queue"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "id": "4e9fe81c-1a9d-53fa-8c2f-fd6e2dc28159",
      "name": "Needs staff?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1100,
        220
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.proposed }}",
              "rightValue": "escalate_to_human",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "00981fbc-637c-53f4-8a23-e0a53f41b8aa",
      "name": "Alert staff on Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "chatId": "YOUR_STAFF_CHAT_ID",
        "text": "=⚠️ Review {{ $json.review_id }} ({{ $json.topic }}) needs staff.\n\"{{ $json.review }}\"\nAgent note: {{ $json.draft }}\nApprove in the sheet, row action_id={{ $json.action_id }}.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Telegram account"
        }
      }
    }
  ],
  "connections": {
    "Every 15 minutes": {
      "main": [
        [
          {
            "node": "List new reviews",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "List new reviews": {
      "main": [
        [
          {
            "node": "One item per review",
            "type": "main",
            "index": 0
          }
        ]
      ]
