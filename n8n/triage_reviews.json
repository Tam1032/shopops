    "New review webhook": {
      "main": [
        [
          {
            "node": "Review from webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Review from webhook": {
      "main": [
        [
          {
            "node": "Triage with agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Triage with agent": {
      "main": [
        [
          {
            "node": "Row for approval sheet",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Row for approval sheet": {
      "main": [
        [
          {
            "node": "Append to approval sheet",
            "type": "main",
            "index": 0
          },
          {
            "node": "Needs staff?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Needs staff?": {
      "main": [
        [
          {
